{
  "name": "sigongnote",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/web",
    "services/api",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint apps/web/src services/api/src packages scripts/check-changed.mjs scripts/db-gate.mjs scripts/local-env-values.mjs scripts/configure-local-env.mjs scripts/configure-local-db-role.mjs scripts/generate-contracts.ts scripts/check-native-contracts.ts scripts/test-tenant.mjs scripts/fixture-catalog.mjs scripts/run-case.mjs scripts/recovery-audit.ts scripts/recovery-drill.ts scripts/recovery-synthetic.ts scripts/verification-source.mjs tests",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx tests/*.test.mjs",
    "test:web": "node --import tsx --test --test-name-pattern=UX tests/today-ui.test.tsx tests/directory.test.tsx",
    "check:changed": "node scripts/check-changed.mjs",
    "check:db": "node scripts/db-gate.mjs",
    "dev:web": "npm run dev --workspace @sigongnote/web",
    "dev:worker": "node --import tsx services/api/src/worker-main.ts --local",
    "dev:api": "npm run dev --workspace @sigongnote/api",
    "dev:agent": "node --import tsx services/local-agent/src/main.ts --open",
    "test:agent": "node --import tsx --test tests/local-agent.test.ts",
    "contracts:generate": "tsx scripts/generate-contracts.ts",
    "contracts:check": "tsx scripts/generate-contracts.ts --check",
    "test:contract": "node --import tsx --test tests/contracts.test.ts",
    "test:tenant": "node scripts/test-tenant.mjs",
    "test:auth": "node --import tsx --test tests/auth-devices.test.ts tests/api-config.test.ts",
    "test:ingestion": "node --import tsx --test tests/ingestions.test.ts",
    "test:jobs": "node --import tsx --test tests/jobs.test.ts",
    "test:capture-sources": "node --import tsx --test tests/capture-sources.test.ts",
    "test:fixtures": "node --import tsx --test tests/fixtures.test.ts",
    "test:case": "node scripts/run-case.mjs",
    "test:local-env": "node --test tests/local-env.test.mjs",
    "test:hooks": "node --test tests/claude-hooks.test.mjs tests/agent-tools.test.mjs",
    "e2e:db": "node scripts/e2e-db.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "e2e:showcase": "node --import tsx scripts/e2e-showcase.mts",
    "test:claude": "node --import tsx --test tests/claude-runtime.test.ts",
    "setup:local-env": "node scripts/configure-local-env.mjs",
    "setup:windows-local": "node scripts/configure-windows-local.mjs",
    "setup:local-db-role": "node scripts/configure-local-db-role.mjs",
    "contracts:native": "tsx scripts/check-native-contracts.ts",
    "contracts:package": "node scripts/check-contract-package.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "playwright-core": "1.63.0",
    "postgres": "3.4.9",
    "supabase": "2.118.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
