# Template only. C01 copies relevant keys into services/api/.env (git ignored).
# Frontend contains only API URL and public auth config; never service secrets.
APP_ENV=development
API_BASE_URL=http://localhost:3001
WEB_BASE_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
WORKER_DATABASE_URL=
MIGRATION_DATABASE_URL=
DOCUMENT_WORKER_TOKEN=
# AI_PROVIDER=claude turns on the Claude Agent SDK judgement runtime (request understanding, meaning
# extraction, SMS screening, context restoration). AI_PROVIDER=fixture keeps the no-model local rules.
AI_PROVIDER=claude
AI_API_KEY=
AI_MODEL_SMALL=
AI_MODEL_REVIEW=
AI_DAILY_BUDGET_KRW=10000
# Claude Agent SDK runtime (services/api/src/claude-runtime.ts). The key is read only from the process environment.
ANTHROPIC_API_KEY=
CLAUDE_AGENT_ENABLED=true
CLAUDE_AGENT_MODEL=claude-sonnet-5
# Optional ProductPrice JSON override: version/provider(anthropic)/model/input_krw_per_million/output_krw_per_million/valid_until/conversion_note
CLAUDE_AGENT_PRICE_JSON=
CLAUDE_AGENT_MAX_USD=0.5
STORAGE_BUCKET=evidence-private
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173
LOG_REDACTION_ENABLED=true
VITE_API_BASE_URL=http://localhost:3001
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Paths are selected by each user's native OS picker, never committed here.

# N03 product runtime (independent from legacy fixture AI_* configuration).
# Local development: save selected keys in ignored .env.product.local; restart API/worker.
# Production: hosting secret store only. Never put provider keys in VITE_*.
# Legacy explicit provider override. Leave empty to use the Claude Agent SDK runtime above.
SEMANTIC_PROVIDER=
SEMANTIC_API_KEY=
SEMANTIC_MODEL=
# JSON: version/provider/model/input_krw_per_million/output_krw_per_million/valid_until/conversion_note
SEMANTIC_PRICE_JSON=
# Existing sources must consent to this exact policy before external processing.
CAPTURE_POLICY_JSON=
SHORT_STT_ENABLED=false
SHORT_STT_API_KEY=
SHORT_STT_FFPROBE=
SHORT_STT_DAILY_SECONDS=3600
# JSON: version/model(gpt-transcribe)/krw_per_minute/valid_until
SHORT_STT_PRICE_JSON=
LONG_STT_ENABLED=false
CLOVA_SPEECH_KEY=
CLOVA_SPEECH_INVOKE_URL=
LONG_STT_OBS_CONFIGURED=false
LONG_STT_TENANT_SECONDS=0
LONG_STT_GLOBAL_SECONDS=0
# JSON: version/model(clova-speech)/krw_per_minute/valid_until
LONG_STT_PRICE_JSON=
SIGONGNOTE_TESSERACT=
SIGONGNOTE_TESSDATA_DIR=
