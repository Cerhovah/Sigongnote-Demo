  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for d in \"$(git rev-parse --show-toplevel 2>/dev/null)\" \"${CLAUDE_PROJECT_DIR}\" \"$PWD\"; do f=\"$d/.claude/hooks/lifecycle.mjs\"; [ -n \"$d\" ] && [ -f \"$f\" ] && break; f=; done; [ -n \"$f\" ] && node \"$f\"; exit 0",
            "timeout": 20,
            "statusMessage": "시공노트 상태 읽는 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for d in \"$(git rev-parse --show-toplevel 2>/dev/null)\" \"${CLAUDE_PROJECT_DIR}\" \"$PWD\"; do f=\"$d/.claude/hooks/guard.mjs\"; [ -n \"$d\" ] && [ -f \"$f\" ] && break; f=; done; if [ -z \"$f\" ]; then echo '{\"systemMessage\":\"[guard] guard.mjs 없음: 현재 체크아웃·프로젝트 루트 어디에도 .claude/hooks/guard.mjs 가 없어 셸 가드 없이 진행합니다(permissions.deny·.githooks는 적용 중). 병합 전 브랜치나 동기화 전 메인이면 PR 병합 뒤 git pull 하세요.\"}'; exit 0; fi; command -v node >/dev/null 2>&1 || { echo '{\"systemMessage\":\"[guard] node 없음: Git Bash PATH에서 node를 찾지 못해 셸 가드 없이 진행합니다.\"}'; exit 0; }; node \"$f\" || echo '{\"systemMessage\":\"[guard] 가드 스크립트 오류: 이번 명령은 검사 없이 통과했습니다. npm run test:hooks 로 확인하세요.\"}'; exit 0",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for d in \"$(git rev-parse --show-toplevel 2>/dev/null)\" \"${CLAUDE_PROJECT_DIR}\" \"$PWD\"; do f=\"$d/.claude/hooks/guard.mjs\"; [ -n \"$d\" ] && [ -f \"$f\" ] && break; f=; done; [ -n \"$f\" ] && node \"$f\"; exit 0",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for d in \"$(git rev-parse --show-toplevel 2>/dev/null)\" \"${CLAUDE_PROJECT_DIR}\" \"$PWD\"; do f=\"$d/.claude/hooks/guard.mjs\"; [ -n \"$d\" ] && [ -f \"$f\" ] && break; f=; done; [ -n \"$f\" ] && node \"$f\"; exit 0",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for d in \"$(git rev-parse --show-toplevel 2>/dev/null)\" \"${CLAUDE_PROJECT_DIR}\" \"$PWD\"; do f=\"$d/.claude/hooks/lifecycle.mjs\"; [ -n \"$d\" ] && [ -f \"$f\" ] && break; f=; done; [ -n \"$f\" ] && node \"$f\"; exit 0",
            "timeout": 40
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for d in \"$(git rev-parse --show-toplevel 2>/dev/null)\" \"${CLAUDE_PROJECT_DIR}\" \"$PWD\"; do f=\"$d/.claude/hooks/lifecycle.mjs\"; [ -n \"$d\" ] && [ -f \"$f\" ] && break; f=; done; [ -n \"$f\" ] && node \"$f\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "for d in \"$(git rev-parse --show-toplevel 2>/dev/null)\" \"${CLAUDE_PROJECT_DIR}\" \"$PWD\"; do f=\"$d/.claude/hooks/lifecycle.mjs\"; [ -n \"$d\" ] && [ -f \"$f\" ] && break; f=; done; [ -n \"$f\" ] && node \"$f\"; exit 0",
            "timeout": 15
          }
        ]
      }
    ]
