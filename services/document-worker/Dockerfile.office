FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-calc python3-uno fonts-noto-cjk poppler-utils \
    && rm -rf /var/lib/apt/lists/*
# The renderer runs without network access and with a read-only input bind.
ENV HOME=/tmp/office
WORKDIR /job
ENTRYPOINT ["/usr/bin/python3"]
